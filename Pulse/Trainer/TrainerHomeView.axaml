<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pulse.User.TrainerHomeView">

    <UserControl.Styles>
        <Style Selector="Button.navButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#141414"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.navButton.active">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#E32626"/>
            <Setter Property="BorderBrush" Value="#E32626"/>
        </Style>

        <Style Selector="Button.actionButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#E32626"/>
            <Setter Property="BorderBrush" Value="#E32626"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="22">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Border.infoCard">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Padding" Value="28"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="#F4F4F4">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30,40,150"
                        HorizontalAlignment="Center">

                <Border Width="1050"
                        Padding="0"
                        CornerRadius="30"
                        Background="#FFFFFF"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        ClipToBounds="True">

                    <StackPanel>
                        <Border Background="#151515"
                                Padding="40,36">
                            <StackPanel Spacing="12">
                                <TextBlock Name="WelcomeText"
                                           Text="Добро пожаловать!"
                                           Foreground="White"
                                           FontSize="50"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>

                                <TextBlock Name="DateText"
                                           Text="Сегодня"
                                           Foreground="#CFCFCF"
                                           FontSize="22"
                                           TextWrapping="Wrap"/>

                                <Border Height="4"
                                        Width="120"
                                        Background="#E32626"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="40"
                              ColumnDefinitions="*,*"
                              ColumnSpacing="22">

                            <Border Grid.Column="0"
                                    Classes="infoCard"
                                    MinHeight="310">
                                <Grid RowDefinitions="Auto,Auto,*,Auto"
                                      RowSpacing="14">

                                    <TextBlock Grid.Row="0"
                                               Text="Ближайшее занятие"
                                               Foreground="#141414"
                                               FontSize="30"
                                               FontWeight="Bold"/>

                                    <TextBlock Grid.Row="1"
                                               Name="NearestTrainingTitleText"
                                               Text="Пока нет ближайших занятий"
                                               Foreground="#141414"
                                               FontSize="26"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="2"
                                               Name="NearestTrainingInfoText"
                                               Text="Занятия появятся после составления расписания администратором."
                                               Foreground="#6F6F6F"
                                               FontSize="20"
                                               TextWrapping="Wrap"/>

                                    <Button Grid.Row="3"
                                            Classes="actionButton"
                                            Content="ОТКРЫТЬ РАСПИСАНИЕ"
                                            Height="58"
                                            HorizontalAlignment="Stretch"
                                            Click="OpenSchedulePage"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    Classes="infoCard"
                                    MinHeight="310">
                                <Grid RowDefinitions="Auto,Auto,*,Auto"
                                      RowSpacing="14">

                                    <TextBlock Grid.Row="0"
                                               Text="Мой график"
                                               Foreground="#141414"
                                               FontSize="30"
                                               FontWeight="Bold"/>

                                    <TextBlock Grid.Row="1"
                                               Name="AvailableTimeTitleText"
                                               Text="Свободное время"
                                               Foreground="#141414"
                                               FontSize="26"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="2"
                                               Name="AvailableTimeInfoText"
                                               Text="Добавьте свободные часы, чтобы администратор мог поставить занятия."
                                               Foreground="#6F6F6F"
                                               FontSize="20"
                                               TextWrapping="Wrap"/>

                                    <Button Grid.Row="3"
                                            Classes="actionButton"
                                            Content="ДОБАВИТЬ ГРАФИК"
                                            Height="58"
                                            HorizontalAlignment="Stretch"
                                            Click="OpenAvailableTimePage"/>
                                </Grid>
                            </Border>

                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Margin="24,0,24,24"
                Padding="16"
                Background="#FFFFFF"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="26"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <Button Classes="navButton active"
                        Content="ГЛАВНАЯ"
                        Width="150"
                        Height="56"/>

                <Button Classes="navButton"
                        Content="МОЁ РАСПИСАНИЕ"
                        Width="190"
                        Height="56"
                        Click="OpenSchedulePage"/>

                <Button Classes="navButton"
                        Content="КЛИЕНТЫ"
                        Width="150"
                        Height="56"
                        Click="OpenClientsPage"/>

                <Button Classes="navButton"
                        Content="МОЙ ГРАФИК"
                        Width="160"
                        Height="56"
                        Click="OpenAvailableTimePage"/>

                <Button Classes="navButton"
                        Content="ПРОФИЛЬ"
                        Width="150"
                        Height="56"
                        Click="OpenProfilePage"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>