<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pulse.User.TrainerAvailableTimeView">

    <UserControl.Styles>
        <Style Selector="Button.navButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#141414"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.navButton.active">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#E32626"/>
            <Setter Property="BorderBrush" Value="#E32626"/>
        </Style>

        <Style Selector="Button.actionButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#E32626"/>
            <Setter Property="BorderBrush" Value="#E32626"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="22">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.cancelButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E32626"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E32626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="22">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="DatePicker">
            <Setter Property="Height" Value="58"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#141414"/>
            <Setter Property="BorderBrush" Value="#DADADA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Height" Value="58"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#141414"/>
            <Setter Property="BorderBrush" Value="#DADADA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="#F4F4F4">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30,40,150"
                        Spacing="24"
                        HorizontalAlignment="Center">

                <Border Width="1050"
                        Padding="0"
                        CornerRadius="30"
                        Background="#FFFFFF"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        ClipToBounds="True">

                    <StackPanel>
                        <Border Background="#151515"
                                Padding="40,36">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Мой график"
                                           Foreground="White"
                                           FontSize="50"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Добавьте свободное время, чтобы администратор мог поставить занятие."
                                           Foreground="#CFCFCF"
                                           FontSize="22"
                                           TextWrapping="Wrap"/>

                                <Border Height="4"
                                        Width="120"
                                        Background="#E32626"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="40"
                                    Spacing="24">

                            <Border Background="#F7F7F7"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="28"
                                    Padding="28">

                                <StackPanel Spacing="18">
                                    <TextBlock Text="Добавить свободное время"
                                               Foreground="#141414"
                                               FontSize="32"
                                               FontWeight="Bold"/>

                                    <Border Name="MessageBorder"
                                            Background="#33D92525"
                                            BorderBrush="#D92525"
                                            BorderThickness="1"
                                            CornerRadius="18"
                                            Padding="14"
                                            IsVisible="False">
                                        <TextBlock Name="MessageText"
                                                   Text=""
                                                   Foreground="#D92525"
                                                   FontSize="18"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"/>
                                    </Border>

                                    <Grid ColumnDefinitions="*,*,*"
                                          ColumnSpacing="18">

                                        <StackPanel Grid.Column="0"
                                                    Spacing="8">
                                            <TextBlock Text="Дата"
                                                       Foreground="#141414"
                                                       FontSize="20"
                                                       FontWeight="Bold"/>
                                            <DatePicker Name="DatePicker"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Spacing="8">
                                            <TextBlock Text="Начало"
                                                       Foreground="#141414"
                                                       FontSize="20"
                                                       FontWeight="Bold"/>
                                            <TextBox Name="StartTimeTextBox"
                                                     Watermark="Например 10:00"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Spacing="8">
                                            <TextBlock Text="Конец"
                                                       Foreground="#141414"
                                                       FontSize="20"
                                                       FontWeight="Bold"/>
                                            <TextBox Name="EndTimeTextBox"
                                                     Watermark="Например 18:00"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button Classes="actionButton"
                                            Content="ДОБАВИТЬ В ГРАФИК"
                                            Height="60"
                                            HorizontalAlignment="Stretch"
                                            Click="AddAvailableTime"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Добавленное свободное время"
                                       Foreground="#141414"
                                       FontSize="34"
                                       FontWeight="Bold"/>

                            <StackPanel Name="AvailableTimesPanel"
                                        Spacing="18">
                                <Border Background="#FFFFFF"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="26"
                                        Padding="26">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Загрузка графика..."
                                                   Foreground="#141414"
                                                   FontSize="28"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="Подождите немного"
                                                   Foreground="#6F6F6F"
                                                   FontSize="20"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Margin="24,0,24,24"
                Padding="16"
                Background="#FFFFFF"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="26"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <Button Classes="navButton"
                        Content="ГЛАВНАЯ"
                        Width="150"
                        Height="56"
                        Click="OpenHomePage"/>

                <Button Classes="navButton"
                        Content="МОЁ РАСПИСАНИЕ"
                        Width="190"
                        Height="56"
                        Click="OpenSchedulePage"/>

                <Button Classes="navButton"
                        Content="КЛИЕНТЫ"
                        Width="150"
                        Height="56"
                        Click="OpenClientsPage"/>

                <Button Classes="navButton active"
                        Content="МОЙ ГРАФИК"
                        Width="160"
                        Height="56"/>

                <Button Classes="navButton"
                        Content="ПРОФИЛЬ"
                        Width="150"
                        Height="56"
                        Click="OpenProfilePage"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>