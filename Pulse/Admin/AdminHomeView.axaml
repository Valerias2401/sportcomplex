<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pulse.User.AdminHomeView">

    <UserControl.Styles>
        <Style Selector="Button.navButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#141414"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.navButton.active">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#E32626"/>
            <Setter Property="BorderBrush" Value="#E32626"/>
        </Style>

        <Style Selector="Button.actionButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#E32626"/>
            <Setter Property="BorderBrush" Value="#E32626"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="22">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Border.infoCard">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="#F4F4F4">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,24,40,135"
                        HorizontalAlignment="Center">

                <Border Width="1050"
                        Padding="0"
                        CornerRadius="30"
                        Background="#FFFFFF"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        ClipToBounds="True">

                    <StackPanel>
                        <Border Background="#151515"
                                Padding="36,28">
                            <StackPanel Spacing="10">
                                <TextBlock Name="WelcomeText"
                                           Text="Добро пожаловать!"
                                           Foreground="White"
                                           FontSize="46"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>

                                <TextBlock Name="DateText"
                                           Text="Сегодня"
                                           Foreground="#CFCFCF"
                                           FontSize="21"
                                           TextWrapping="Wrap"/>

                                <Border Height="4"
                                        Width="110"
                                        Background="#E32626"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="36"
                                    Spacing="20">

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="20">

                                <Border Grid.Column="0"
                                        Classes="infoCard"
                                        MinHeight="245">
                                    <Grid RowDefinitions="Auto,Auto,*,Auto"
                                          RowSpacing="10">

                                        <TextBlock Grid.Row="0"
                                                   Text="Записи на сегодня"
                                                   Foreground="#141414"
                                                   FontSize="28"
                                                   FontWeight="Bold"/>

                                        <TextBlock Grid.Row="1"
                                                   Name="TodayRecordsCountText"
                                                   Text="0"
                                                   Foreground="#E32626"
                                                   FontSize="46"
                                                   FontWeight="Bold"/>

                                        <TextBlock Grid.Row="2"
                                                   Name="TodayRecordsInfoText"
                                                   Text="Сегодня пока нет записей клиентов."
                                                   Foreground="#6F6F6F"
                                                   FontSize="19"
                                                   TextWrapping="Wrap"/>

                                        <Button Grid.Row="3"
                                                Classes="actionButton"
                                                Content="ОТКРЫТЬ КЛИЕНТОВ"
                                                Height="54"
                                                HorizontalAlignment="Stretch"
                                                Click="OpenClientsPage"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1"
                                        Classes="infoCard"
                                        MinHeight="245">
                                    <Grid RowDefinitions="Auto,Auto,*,Auto"
                                          RowSpacing="10">

                                        <TextBlock Grid.Row="0"
                                                   Text="Свободный график"
                                                   Foreground="#141414"
                                                   FontSize="28"
                                                   FontWeight="Bold"/>

                                        <TextBlock Grid.Row="1"
                                                   Name="FreeTimesCountText"
                                                   Text="0"
                                                   Foreground="#E32626"
                                                   FontSize="46"
                                                   FontWeight="Bold"/>

                                        <TextBlock Grid.Row="2"
                                                   Name="FreeTimesInfoText"
                                                   Text="Нет свободного времени тренеров."
                                                   Foreground="#6F6F6F"
                                                   FontSize="19"
                                                   TextWrapping="Wrap"/>

                                        <Button Grid.Row="3"
                                                Classes="actionButton"
                                                Content="ГРАФИК ТРЕНЕРОВ"
                                                Height="54"
                                                HorizontalAlignment="Stretch"
                                                Click="OpenTrainerTimesPage"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Classes="infoCard"
                                    Padding="24">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="18">

                                    <StackPanel Grid.Column="0"
                                                Spacing="6">
                                        <TextBlock Text="Управление расписанием"
                                                   Foreground="#141414"
                                                   FontSize="28"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="Создавайте занятия, выбирайте услугу, тренера, дату, время и количество мест."
                                                   Foreground="#6F6F6F"
                                                   FontSize="19"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Classes="actionButton"
                                            Content="СОЗДАТЬ ЗАНЯТИЕ"
                                            Width="220"
                                            Height="56"
                                            VerticalAlignment="Center"
                                            Click="OpenSchedulePage"/>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Margin="24,0,24,24"
                Padding="16"
                Background="#FFFFFF"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="26"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <Button Classes="navButton active"
                        Content="ГЛАВНАЯ"
                        Width="150"
                        Height="56"/>

                <Button Classes="navButton"
                        Content="РАСПИСАНИЕ"
                        Width="170"
                        Height="56"
                        Click="OpenSchedulePage"/>

                <Button Classes="navButton"
                        Content="ГРАФИК ТРЕНЕРОВ"
                        Width="220"
                        Height="56"
                        Click="OpenTrainerTimesPage"/>

                <Button Classes="navButton"
                        Content="КЛИЕНТЫ"
                        Width="150"
                        Height="56"
                        Click="OpenClientsPage"/>

                <Button Classes="navButton"
                        Content="ПРОФИЛЬ"
                        Width="150"
                        Height="56"
                        Click="OpenProfilePage"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>