<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pulse.User.AdminProfileView">

    <UserControl.Styles>
        <Style Selector="Button.navButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#141414"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.navButton.active">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#E32626"/>
            <Setter Property="BorderBrush" Value="#E32626"/>
        </Style>

        <Style Selector="Button.logoutButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#E32626"/>
            <Setter Property="BorderBrush" Value="#E32626"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="22">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid Background="#F4F4F4">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30,40,150"
                        HorizontalAlignment="Center">

                <Border Width="1050"
                        Padding="0"
                        CornerRadius="30"
                        Background="#FFFFFF"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        ClipToBounds="True">

                    <StackPanel>
                        <Border Background="#151515"
                                Padding="40,36">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Профиль администратора"
                                           Foreground="White"
                                           FontSize="50"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="Данные рабочего аккаунта администратора."
                                           Foreground="#CFCFCF"
                                           FontSize="22"
                                           TextWrapping="Wrap"/>

                                <Border Height="4"
                                        Width="120"
                                        Background="#E32626"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="40"
                                    Spacing="24">

                            <Border Background="#FFFFFF"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="26"
                                    Padding="30">

                                <StackPanel Spacing="18">
                                    <TextBlock Name="FullNameText"
                                               Text="ФИО"
                                               Foreground="#141414"
                                               FontSize="34"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Name="EmailText"
                                               Text="Email"
                                               Foreground="#6F6F6F"
                                               FontSize="22"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Name="PhoneText"
                                               Text="Телефон"
                                               Foreground="#6F6F6F"
                                               FontSize="22"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Name="RoleText"
                                               Text="Роль: администратор"
                                               Foreground="#E32626"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Button Classes="logoutButton"
                                    Content="ВЫЙТИ ИЗ АККАУНТА"
                                    Height="62"
                                    HorizontalAlignment="Stretch"
                                    Click="Logout"/>

                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Margin="24,0,24,24"
                Padding="16"
                Background="#FFFFFF"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="26"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <Button Classes="navButton"
                        Content="ГЛАВНАЯ"
                        Width="150"
                        Height="56"
                        Click="OpenHome"/>

                <Button Classes="navButton"
                        Content="РАСПИСАНИЕ"
                        Width="170"
                        Height="56"
                        Click="OpenSchedule"/>

                <Button Classes="navButton"
                        Content="ГРАФИК ТРЕНЕРОВ"
                        Width="220"
                        Height="56"
                        Click="OpenTimes"/>

                <Button Classes="navButton"
                        Content="КЛИЕНТЫ"
                        Width="150"
                        Height="56"
                        Click="OpenClients"/>

                <Button Classes="navButton active"
                        Content="ПРОФИЛЬ"
                        Width="150"
                        Height="56"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>