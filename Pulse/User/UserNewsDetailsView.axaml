<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pulse.User.UserNewsDetailsView">

    <UserControl.Styles>
        <Style Selector="Button.backButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#E32626"/>
            <Setter Property="BorderBrush" Value="#E32626"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="22">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Image Source="avares://Pulse/Assets/Images/боксер.png"
               Stretch="UniformToFill"/>

        <Rectangle Fill="#33000000"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30,40,40"
                        HorizontalAlignment="Center"
                        Spacing="24">

                <Border Width="1000"
                        Padding="0"
                        CornerRadius="30"
                        Background="#BBFFFFFF"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        ClipToBounds="True">

                    <StackPanel>

                        <Border Background="#CC151515"
                                Padding="40,34">

                            <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                                <!-- кнопка СЛЕВА -->
                                <Button Classes="backButton"
                                        Content="← НАЗАД К НОВОСТЯМ"
                                        Width="250"
                                        Height="56"
                                        HorizontalAlignment="Left"
                                        Click="BackToNews"/>

                                <!-- дата ПО ЦЕНТРУ -->
                                <TextBlock Grid.Row="1"
                                           Name="DateText"
                                           Text="Дата"
                                           Foreground="#E32626"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0"/>

                                <!-- заголовок -->
                                <TextBlock Grid.Row="2"
                                           Name="TitleText"
                                           Text="Заголовок"
                                           Foreground="White"
                                           FontSize="46"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0"/>

                                <!-- линия -->
                                <Border Grid.Row="3"
                                        Height="4"
                                        Width="120"
                                        Background="#E32626"
                                        CornerRadius="4"
                                        HorizontalAlignment="Center"
                                        Margin="0,10,0,0"/>

                            </Grid>
                        </Border>

                        <StackPanel Spacing="24"
                                    Margin="40">

                            <Border Height="360"
                                    Background="#151515"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="26"
                                    ClipToBounds="True">
                                <Image Name="NewsImage"
                                       Stretch="UniformToFill"/>
                            </Border>

                            <TextBlock Name="ContentText"
                                       Text="Текст новости"
                                       Foreground="#6F6F6F"
                                       FontSize="24"
                                       TextWrapping="Wrap"
                                       LineHeight="34"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>