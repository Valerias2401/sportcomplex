<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Pulse"
        x:Class="Pulse.MainWindow"
        Width="1600"
        Height="900"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        CanResize="True"
        WindowState="Maximized"
    Title="ПУЛЬС"
    Icon="avares://Pulse/Assets/Images/logo1.ico">

    <Window.Styles>
        <Style Selector="Button.menuButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="28"
                            ClipToBounds="True">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.menuButton.primary">
            <Setter Property="Background" Value="#D92525"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Button.menuButton.secondary">
            <Setter Property="Background" Value="#00000000"/>
            <Setter Property="BorderBrush" Value="#D92525"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Button.menuButton:pointerover /template/ Border#Root">
            <Setter Property="Opacity" Value="0.95"/>
        </Style>

        <Style Selector="Button.menuButton:pressed /template/ Border#Root">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Image Source="avares://Pulse/Assets/Images/ПУЛЬСЫ 1.png"
               Stretch="UniformToFill"/>

        <Border x:Name="MainMenuPanel"
                Width="620"
                Height="300"
                Background="#7A000000"
                CornerRadius="24"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Canvas>
                <Button Classes="menuButton primary"
                        Width="480"
                        Height="78"
                        Content="ВОЙТИ"
                        Canvas.Left="70"
                        Canvas.Top="55"
                        Click="OpenLoginView"/>

                <Button Classes="menuButton secondary"
                        Width="480"
                        Height="78"
                        Content="ЗАРЕГИСТРИРОВАТЬСЯ"
                        Canvas.Left="70"
                        Canvas.Top="165"
                        Click="OpenRegisterView"/>
            </Canvas>
        </Border>

        <Border x:Name="ContentPanel"
                IsVisible="False"
                Background="#00000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <ContentControl x:Name="MainContent"/>
        </Border>
    </Grid>
</Window>